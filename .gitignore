# ---------------------------------------------------------------------------
# Deployment safety (added for the aaPanel / GitHub deploy)
# ---------------------------------------------------------------------------

# Real environment files (keep ONLY the *.template files in git).
**/.env
**/.env.local
**/.env.production
**/.env.*.local
!**/.env*.template

# Database dumps contain customer PII — never commit. Upload to the server
# directly instead. (deploy/aapanel/fix-image-urls.sql is intentionally kept.)
/medusa-store-export.sql
*.dump
/_diag.sql

# Uploaded assets / customer-submitted files live in persistent storage on the
# server, not in git.
apps/backend/data/

# Playwright MCP debug artifacts (hundreds of logs) — not part of the app.
.playwright-mcp/

# Local archives
*.rar
*.zip
*.7z

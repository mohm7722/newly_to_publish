STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- Abandoned-cart reminder ---
# Storefront base URL + default region used to build the cart resume link.
STOREFRONT_URL=http://localhost:8000
STOREFRONT_DEFAULT_REGION=us
# Detection schedule (cron) and thresholds.
ABANDONED_CART_CRON=*/15 * * * *
ABANDONED_CART_IDLE_MINUTES=60
ABANDONED_CART_MAX_REMINDERS=1
ABANDONED_CART_REMINDER_INTERVAL_MINUTES=1440
# Do not re-target carts older than this (hours). Default: 7 days.
ABANDONED_CART_MAX_AGE_HOURS=168
# Email delivery: leave SendGrid unset to use the local (logging) provider.
# SENDGRID_API_KEY=
# SENDGRID_FROM=no-reply@example.com
# ABANDONED_CART_EMAIL_TEMPLATE=abandoned-cart

# --- Ad conversion tracking (server-side) ---
# SECRETS: keep these in env only. Server sending is disabled until they are set.
# META_CAPI_ACCESS_TOKEN=
# GA4_API_SECRET=
#
# Public identifiers (Meta Pixel id, GA4 Measurement id, GTM id, Meta API
# version / test code) are managed from the admin dashboard
# (Settings > تتبّع الإعلانات) and stored in the database. The env values below
# are OPTIONAL fallbacks used only when the database value is empty.
# META_PIXEL_ID=
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GTM_ID=GTM-XXXXXXX
# META_API_VERSION=v19.0
# META_TEST_EVENT_CODE=            # only for Events Manager "Test events"

# --- Storefront catalog cache revalidation ---
# Internal URL of the storefront endpoint and a shared random secret.
STOREFRONT_REVALIDATE_URL=http://localhost:8000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=

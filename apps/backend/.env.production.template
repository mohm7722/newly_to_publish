# ============================================================================
# Medusa backend - PRODUCTION environment  (www.newlyye.com on aaPanel)
# ----------------------------------------------------------------------------
# On the server, copy this file to `.env` and fill in the real values:
#     cp .env.production.template .env
# `run-server.sh` copies this `.env` into `.medusa/server/.env` on every start.
# NEVER commit the filled-in `.env` (it is gitignored).
#
# Generate every secret below with a fresh random value:
#     openssl rand -hex 32
# ============================================================================

NODE_ENV=production

# --- Database: PostgreSQL on the same server (aaPanel > PostgreSQL Manager) ---
# Database + user already created in aaPanel as `medusa_store`. Paste its password.
# Format: postgres://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgres://medusa_store:7X3HZjmSR636d2tp@localhost:5432/medusa_store

# --- Redis on the same server (aaPanel > App Store > Redis) ---
# If you set a Redis password in aaPanel, use:
#     redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379
REDIS_URL=redis://localhost:6379

# --- Secrets (generate each one with: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_MFA_ENCRYPTION_KEY

# --- CORS: the live HTTPS domain(s) ---
STORE_CORS=https://www.newlyye.com,https://newlyye.com
ADMIN_CORS=https://www.newlyye.com
AUTH_CORS=https://www.newlyye.com,https://newlyye.com

# --- HTTPS session cookie ---
# SSL is enabled (Let's Encrypt via aaPanel), so the admin cookie must be Secure.
COOKIE_SECURE=true

# --- Abandoned-cart reminder ---
STOREFRONT_URL=https://www.newlyye.com
STOREFRONT_DEFAULT_REGION=ye
ABANDONED_CART_CRON=*/15 * * * *
ABANDONED_CART_IDLE_MINUTES=60
ABANDONED_CART_MAX_REMINDERS=1
ABANDONED_CART_REMINDER_INTERVAL_MINUTES=1440
# Do not re-target carts older than this (hours). Default: 7 days.
ABANDONED_CART_MAX_AGE_HOURS=168
# Email delivery: leave SendGrid unset to use the local (logging) provider.
# SENDGRID_API_KEY=
# SENDGRID_FROM=no-reply@newlyye.com
# ABANDONED_CART_EMAIL_TEMPLATE=abandoned-cart

# --- Storefront catalog cache revalidation ---
# STOREFRONT_REVALIDATE_SECRET must match the same key in the storefront env.
STOREFRONT_REVALIDATE_URL=http://localhost:8000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET

# --- Uploaded product images (local file storage) ---
# Public origin baked into stored image URLs when a NEW image is uploaded via
# the admin. Must be the HTTPS domain + /static, or new uploads get localhost
# URLs. Existing imported URLs are rewritten by the deploy script separately.
FILE_BACKEND_URL=https://www.newlyye.com/static
# Persistent on-disk folder the images live in (run-server.sh symlinks
# .medusa/server/static to it so uploads survive every rebuild).
FILE_UPLOAD_PERSIST_DIR=/www/wwwroot/newly/runtime-data/uploads

# --- Manual bank-transfer proof uploads (persistent disk storage) ---
# Linux path on the server; created by the deploy script. Keep it OUTSIDE the
# build output so uploads survive every rebuild.
MANUAL_TRANSFER_PROOF_DIR=/www/wwwroot/newly/runtime-data/manual-transfer-proofs

# --- Ad conversion tracking (optional server-side secrets) ---
# Public ids (Pixel, GA4, GTM) are managed from the admin dashboard; these are
# only the private tokens, kept in env. Leave unset to disable server sending.
# META_CAPI_ACCESS_TOKEN=
# GA4_API_SECRET=

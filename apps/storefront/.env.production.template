# ============================================================================
# Storefront (Next.js) - PRODUCTION environment  (www.newlyye.com on aaPanel)
# ----------------------------------------------------------------------------
# On the server, copy this file to `.env.production` (or `.env`) and fill it in:
#     cp .env.production.template .env.production
#
# IMPORTANT: all NEXT_PUBLIC_* values are baked in at BUILD time. If you change
# any of them you MUST rebuild the storefront (`npm run build`) for the change
# to take effect.
# ============================================================================

# Publishable API key from the Medusa admin (Settings > Publishable API keys).
# Because we migrate the existing database (option A), the current key below is
# already valid after import - keep it. If you later rotate it in the admin,
# paste the new value here and rebuild the storefront.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_36571a982f2903eeba2daeb8742fed734b7f1561d7b801f87a7952fca2f80be8

# Public backend URL used by the browser (must be the HTTPS domain).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://www.newlyye.com

# Internal backend URL for server-side fetches (SSR/build/middleware).
# Use loopback so the server does not route out to the public domain.
MEDUSA_BACKEND_URL=http://localhost:9000

# Default region country code (Yemen). Change if your default region differs.
NEXT_PUBLIC_DEFAULT_REGION=ye

# Public base URL of the storefront.
NEXT_PUBLIC_BASE_URL=https://www.newlyye.com

# Stripe publishable key (optional).
# NEXT_PUBLIC_STRIPE_KEY=

# --- Ad tracking (client-side) ---
# GTM container id. Primarily managed from the admin dashboard and fetched at
# runtime; this is only a build-time fallback.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Catalog cache revalidation ---
# Must match STOREFRONT_REVALIDATE_SECRET in the backend environment.
STOREFRONT_REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET

# Storefront environment template. Copy to `.env.local` and fill in values.

# Publishable API key from your Medusa backend (Settings > Publishable API key).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Public URL of your Medusa backend (used by the browser).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Internal backend URL used for server-side fetches (build + SSR + middleware).
# Set this to the loopback address on single-server deployments so the app does
# not route out to the public IP/domain (which many hosts, e.g. AWS EC2, cannot
# reach from within themselves). Leave unset to reuse NEXT_PUBLIC_MEDUSA_BACKEND_URL.
MEDUSA_BACKEND_URL=http://localhost:9000
# Default region country code.
NEXT_PUBLIC_DEFAULT_REGION=dk
# Base URL of the storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# Stripe publishable key (optional).
# NEXT_PUBLIC_STRIPE_KEY=

# --- Ad tracking (client-side) ---
# Google Tag Manager container id. Primarily managed from the admin dashboard
# (Settings > تتبّع الإعلانات) and fetched at runtime from the backend, so this
# env var is only a build-time FALLBACK used when the database value is empty.
# GTM loads and manages the Meta Pixel and GA4 tags; the storefront only pushes
# standardized ecommerce events to the dataLayer.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Catalog cache revalidation ---
# Must match STOREFRONT_REVALIDATE_SECRET in the backend environment.
STOREFRONT_REVALIDATE_SECRET=
